# ── 设备标识 ──
DEVICE_ID=K803-001

# ── GNSS (K803_EK0407) ──
GPS_MODE=serial              # serial | tcp | udp
GPS_PORT=/dev/ttyAMA0        # K803 串口 (Windows: COM3)
GPS_BAUD=115200              # K803 波特率
GPS_TIMEOUT=3.0

# ── 无线数据传输 (CM510-71F) ──
TRANSPORT=mqtt               # mqtt | tcp | udp
CM510_HOST=192.168.1.100     # CM510-71F IP 地址
CM510_PORT=8888              # CM510-71F 端口
CM510_TIMEOUT=5.0

# ── MQTT (备用) ──
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
MQTT_TOPIC_SURVEY=survey/data
MQTT_TOPIC_RESPONSE=survey/response

# ── 勘测参数 ──
SURVEY_INTERVAL=10           # 勘测间隔(秒)

# ── 安全 ──
HMAC_KEY=                    # 消息签名密钥 (留空=不签名)

# ── 扩展检测开关 (预留) ──
ENABLE_RTK_QUALITY=true      # RTK 固定解检测
ENABLE_STABILITY=false       # 架站稳定性检测
ENABLE_IMU_CHECK=false       # [预留] IMU 姿态检测
ENABLE_DUAL_ANTENNA=false    # [预留] 双天线基线校验
